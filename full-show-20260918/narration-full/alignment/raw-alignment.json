      {
        "id": "03-01",
        "lines": [
          "建築每天的運作，",
          "又該怎麼理解？"
        ],
        "speechStartMs": 130,
        "speechEndMs": 2690,
        "rawStartMs": 130,
        "rawEndMs": 2690
      },
      {
        "id": "03-02",
        "lines": [
          "分布各處的感測訊號，",
          "逐步匯集，"
        ],
        "speechStartMs": 3920,
        "speechEndMs": 7415,
        "rawStartMs": 3920,
        "rawEndMs": 7415
      },
      {
        "id": "03-03",
        "lines": [
          "形成理解全棟運作的線索。"
        ],
        "speechStartMs": 7415,
        "speechEndMs": 9760,
        "rawStartMs": 7415,
        "rawEndMs": 9760
      },
      {
        "id": "03-04",
        "lines": [
          "環境讀值與用電資訊，"
        ],
        "speechStartMs": 11080,
        "speechEndMs": 13490,
        "rawStartMs": 11080,
        "rawEndMs": 13490
      },
      {
        "id": "03-05",
        "lines": [
