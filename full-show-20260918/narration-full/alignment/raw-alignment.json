        ],
        "speechStartMs": 19600,
        "speechEndMs": 23110,
        "rawStartMs": 19600,
        "rawEndMs": 23110
      },
      {
        "id": "02-07",
        "lines": [
          "讓查找有方向，",
          "後續的檢查與維養有依據。"
        ],
        "speechStartMs": 23680,
        "speechEndMs": 27730,
        "rawStartMs": 23680,
        "rawEndMs": 27730
