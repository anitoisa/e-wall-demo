    "cues": [
      {
        "id": "01-01",
        "lines": [
          "完工，是生活的開始，",
          "也是長期維養的起點。"
        ],
        "speechStartMs": 160,
        "speechEndMs": 3800,
        "rawStartMs": 160,
        "rawEndMs": 3800
      },
      {
        "id": "01-02",
        "lines": [
          "日夜交替，年份向前，",
          "建築的履歷也持續累積。"
        ],
        "speechStartMs": 5040,
        "speechEndMs": 9970,
        "rawStartMs": 5040,
        "rawEndMs": 9970
      },
      {
        "id": "01-03",
        "lines": [
          "從建造查驗，",
          "到日常保養與設備更新，"
        ],
        "speechStartMs": 11400,
        "speechEndMs": 14960,
        "rawStartMs": 11400,
        "rawEndMs": 14960
      },
      {
        "id": "01-04",
        "lines": [
          "依據使用狀況，",
          "逐步調整維養計畫。"
        ],
        "speechStartMs": 15110,
        "speechEndMs": 18190,
        "rawStartMs": 15110,
        "rawEndMs": 18190
      },
      {
        "id": "01-05",
        "lines": [
          "以一百二十年的長壽建築為願景，",
          "需要持續的照顧與準備。"
        ],
        "speechStartMs": 19640,
        "speechEndMs": 24810,
        "rawStartMs": 19640,
        "rawEndMs": 24810
      },
      {
        "id": "01-06",
        "lines": [
          "管理者更替，紀錄一起交接，"
        ],
        "speechStartMs": 26120,
        "speechEndMs": 28910,
        "rawStartMs": 26120,
        "rawEndMs": 28910
      },
      {
        "id": "01-07",
        "lines": [
          "讓照顧建築的經驗，",
          "跨越世代。"
        ],
        "speechStartMs": 29520,
        "speechEndMs": 32440,
        "rawStartMs": 29520,
        "rawEndMs": 32440
      }
    ]
