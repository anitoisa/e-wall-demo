    "cues": [
      {
        "id": "00-01",
        "lines": [
          "傳統的建築，",
          "設計圖說、設備文件和維養紀錄，"
        ],
        "speechStartMs": 180,
        "speechEndMs": 4940,
        "rawStartMs": 180,
        "rawEndMs": 4940
      },
      {
        "id": "00-02",
        "lines": [
          "可能隨著時間與人員更替，",
          "逐漸散失。"
        ],
        "speechStartMs": 5330,
        "speechEndMs": 10860,
        "rawStartMs": 5330,
        "rawEndMs": 10860
      },
      {
        "id": "00-03",
        "lines": [
          "在這裡，",
          "我們用生命履歷與數位分身，"
        ],
        "speechStartMs": 11180,
        "speechEndMs": 15380,
        "rawStartMs": 11180,
        "rawEndMs": 15380
      },
      {
        "id": "00-04",
        "lines": [
          "為建築保留記憶。"
        ],
        "speechStartMs": 15380,
        "speechEndMs": 17320,
        "rawStartMs": 15380,
        "rawEndMs": 17320
      },
      {
        "id": "00-05",
        "lines": [
          "從建造時留下的資料，",
          "到日後每一次保養與更新，"
        ],
        "speechStartMs": 17900,
        "speechEndMs": 22850,
        "rawStartMs": 17900,
        "rawEndMs": 22850
      },
      {
        "id": "00-06",
        "lines": [
          "讓新的紀錄接續累積，"
        ],
        "speechStartMs": 23080,
        "speechEndMs": 25940,
        "rawStartMs": 23080,
        "rawEndMs": 25940
      },
      {
        "id": "00-07",
        "lines": [
          "也讓過去的經驗",
          "能夠回頭查閱。"
        ],
        "speechStartMs": 26500,
        "speechEndMs": 30400,
        "rawStartMs": 26500,
        "rawEndMs": 30400
      },
      {
        "id": "00-08",
        "lines": [
          "當資訊有了對應的位置與身分，"
        ],
        "speechStartMs": 30580,
        "speechEndMs": 33650,
        "rawStartMs": 30580,
        "rawEndMs": 33650
      },
      {
        "id": "00-09",
        "lines": [
          "接手的人，就能理解這棟建築",
          "曾經受到哪些照顧。"
        ],
        "speechStartMs": 33820,
        "speechEndMs": 39980,
        "rawStartMs": 33820,
        "rawEndMs": 39980
      },
      {
        "id": "00-10",
        "lines": [
          "社區的管理，",
          "也不必每一次都從零開始。"
        ],
        "speechStartMs": 40580,
        "speechEndMs": 44240,
        "rawStartMs": 40580,
        "rawEndMs": 44240
      }
    ]
  },
