        ],
        "speechStartMs": 4800,
        "speechEndMs": 7000,
        "rawStartMs": 4800,
        "rawEndMs": 7000
      },
      {
        "id": "02-03",
        "lines": [
          "看清給水、排水與消防系統",
          "的空間關係。"
        ],
        "speechStartMs": 7330,
        "speechEndMs": 11620,
        "rawStartMs": 7330,
        "rawEndMs": 11620
      },
      {
        "id": "02-04",
        "lines": [
          "沿著管線找到設備，"
        ],
        "speechStartMs": 12700,
        "speechEndMs": 14890,
        "rawStartMs": 12700,
        "rawEndMs": 14890
      },
      {
        "id": "02-05",
        "lines": [
          "再查閱對應的身分、",
          "文件與維養紀錄。"
        ],
        "speechStartMs": 15230,
        "speechEndMs": 18350,
        "rawStartMs": 15230,
        "rawEndMs": 18350
      },
      {
        "id": "02-06",
        "lines": [
